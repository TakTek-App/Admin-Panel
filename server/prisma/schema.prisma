// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  email       String    @unique
  phone       String?   @unique @default("")
  password    String
  address     String
  city        String
  zipCode     String
  businessReg String?     @default("")
  driverLicense String?   @default("")
  driverLicenseExpDate  String?   @default("")
  insurance   String?   @default("")
  insuranceExpDate String?   @default("")
  license     String?   @default("")
  amountDue   Float?    @default(0.0)
  services    Service[] @relation("CompanyServices")
  technicians Technician[]
  reviews     CompanyReview[]
  agents      Agent[]
}

model Technician {
  id          Int       @id @default(autoincrement())
  verified    Boolean?  @default(false)
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  photo       String?   @default("https://firebasestorage.googleapis.com/v0/b/sds-main-29a46.firebasestorage.app/o/images%2FDefault_pfp.jpg?alt=media&token=ba6fbe28-95ea-4b5e-be33-c0a562ba85b3")
  companyId   String
  license     String?   @default("")
  licenseExpDate String?   @default("")
  reviews     TechnicianReview[]
  rating      Float?    @default(5.0)
  company     Company   @relation(fields: [companyId], references: [id])
  jobs        Job[]
  calls       Call[]
  services    Service[]  @relation("TechnicianServices")
}

model TechnicianReview {
  id              Int       @id @default(autoincrement())
  description     String?   @default("")
  rating          Float     @default(5.0)
  technicianId    Int
  jobId           Int  @unique @default(1)
  technician      Technician @relation(fields: [technicianId], references: [id])
  job             Job  @relation(fields: [jobId], references: [id])
}

model CompanyReview {
  id              Int       @id @default(autoincrement())
  description     String?   @default("")
  rating          Float     @default(5.0)
  companyId       String
  company         Company @relation(fields: [companyId], references: [id])
}

model UserReview {
  id              Int       @id @default(autoincrement())
  description     String?   @default("")
  rating          Float  @default(5.0)
  userId          Int
  jobId           Int  @unique @default(1)
  user            User @relation(fields: [userId], references: [id])
  job             Job  @relation(fields: [jobId], references: [id])
}

model User {
  id          Int    @id @default(autoincrement())
  verified    Boolean @default(false)
  firstName   String
  lastName    String
  email       String @unique
  phone       String @unique
  password    String
  photo       String?    @default("https://firebasestorage.googleapis.com/v0/b/sds-main-29a46.firebasestorage.app/o/images%2FDefault_pfp.jpg?alt=media&token=ba6fbe28-95ea-4b5e-be33-c0a562ba85b3")
  jobs        Job[]
  calls       Call[]
  reviews     UserReview[]
}

model Call {
  id               Int             @id @default(autoincrement())
  date             DateTime?       @default(now())
  userId           Int
  technicianId     Int
  user             User            @relation(fields: [userId], references: [id])
  technician       Technician      @relation(fields: [technicianId], references: [id])
}

model Service {
  id            Int             @id @default(autoincrement())
  name          String
  categoryId    Int
  category      Category        @relation(fields: [categoryId], references: [id])
  companies     Company[]       @relation("CompanyServices")
  technicians   Technician[]    @relation("TechnicianServices")
  jobs          Job[]
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  services      Service[]
}

model Job {
  id            Int             @id @default(autoincrement())
  date          DateTime?        @default(now())
  completed     Boolean?         @default(false)
  userId        Int
  technicianId  Int
  serviceId     Int
  user          User            @relation(fields: [userId], references: [id])
  technician    Technician      @relation(fields: [technicianId], references: [id])
  service       Service         @relation(fields: [serviceId], references: [id])
  UserReview    UserReview?
  TechnicianReview TechnicianReview?
}

model Agent {
  id            Int         @id @default(autoincrement())
  companyId     String
  firstName     String
  lastName      String
  email         String      @unique
  password      String
  company       Company     @relation(fields: [companyId], references: [id])
}